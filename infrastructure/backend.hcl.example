# Example backend settings of the app stack. Copy to backend.hcl and run terraform init -backend-config=backend.hcl.
bucket       = "my-event-terraform-state"
key          = "app/terraform.tfstate"
region       = "eu-central-1"
encrypt      = true
use_lockfile = true
