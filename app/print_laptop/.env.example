# Settings of the print laptop's program. Copy to .env next to print_laptop.py and fill in.
# Values are taken literally: Windows paths need no quotes and keep their backslashes.

# The sticker templates made in P-touch Editor, and the Windows printer. The one-line template has the
# placeholders "Name Surname", "Attendee", "2027"; the two-line one (for long names; empty: long names
# shrink on one line) "Name", "Surname", "Attendee", "2027".
TEMPLATE_PATH=C:\Users\<windows-user>\Desktop\attendee.lbx
TEMPLATE_2LINE_PATH=C:\Users\<windows-user>\Desktop\attendee-2line.lbx
PRINTER_NAME=Brother QL-820NWB
# The loaded roll's name as --check shows it (DK-22205 shows as 62mm). Empty: compare with the template.
ROLL=62mm

# Lines 2 and 3 of the sticker. Empty keeps the template's text.
STICKER_ATTENDEE_TEXT=Attendee
STICKER_YEAR_TEXT=2027

# Fonts per line: name, size in points, bold yes/no. Empty keeps the template's.
STICKER_NAME_FONT=Arial
STICKER_NAME_SIZE=20
STICKER_NAME_BOLD=yes
STICKER_ATTENDEE_FONT=Arial
STICKER_ATTENDEE_SIZE=10
STICKER_ATTENDEE_BOLD=no
STICKER_YEAR_FONT=Arial
STICKER_YEAR_SIZE=10
STICKER_YEAR_BOLD=yes

# Long names: names over STICKER_NAME_FIT_CHARS characters use the two-line template (first name, then last
# name, in STICKER_2LINE_NAME_SIZE; empty keeps the template's size). A line over STICKER_2LINE_FIT_CHARS
# characters shrinks, never below STICKER_NAME_MIN_SIZE points.
STICKER_NAME_FIT_CHARS=16
STICKER_2LINE_NAME_SIZE=
STICKER_2LINE_FIT_CHARS=20
STICKER_NAME_MIN_SIZE=8
# Each name line is as large as fits STICKER_FILL_PERCENT of the sticker's width (measured in its font),
# up to its full size. STICKER_2LINE_SAME_SIZE=yes gives first and last name the same (smaller) size.
STICKER_FILL_PERCENT=90
STICKER_2LINE_SAME_SIZE=no

# The print queue (needed by the queue loop, not by --check or --test).
AWS_PROFILE=cd-print-laptop
AWS_REGION=eu-central-1
QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/<account-id>/cd-registration-print-requests
